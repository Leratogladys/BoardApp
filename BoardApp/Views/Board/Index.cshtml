@model IEnumerable<BoardApp.Models.Board>

@{
    ViewData["Title"] = "Board Management";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="display-4">Board Management</h1>
            <p class="text-muted">View and manage all boards in your inventory</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Create" class="btn btn-primary btn-lg">
                <i class="bi bi-plus-circle"></i> Create New Board
            </a>
        </div>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.First().BoardCode)</th>
                            <th>@Html.DisplayNameFor(model => model.First().Make)</th>
                            <th>@Html.DisplayNameFor(model => model.First().Model)</th>
                            <th>@Html.DisplayNameFor(model => model.First().FlashKb)</th>
                            <th>@Html.DisplayNameFor(model => model.First().Price)</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-info">@Html.DisplayFor(modelItem => item.BoardCode)</span>
                                    </td>
                                    <td>@Html.DisplayFor(modelItem => item.Make)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Model)</td>
                                    <td>@Html.DisplayFor(modelItem => item.FlashKb) KB</td>
                                    <td>
                                        <span class="badge bg-success">$@Html.DisplayFor(modelItem => item.Price)</span>
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@item.BoardCode" class="btn btn-sm btn-info" title="View Details">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.BoardCode" class="btn btn-sm btn-warning" title="Edit Board">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.BoardCode" class="btn btn-sm btn-danger" title="Delete Board">
                                            <i class="bi bi-trash"></i> Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4">
                                    <p class="text-muted mb-3">No boards found in inventory.</p>
                                    <a asp-action="Create" class="btn btn-primary">Create First Board</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f5f5f5;
    }

    .btn-group-vertical .btn,
    .btn {
        transition: all 0.3s ease;
    }

    .btn:hover {
        transform: translateY(-2px);
    }
</style>
